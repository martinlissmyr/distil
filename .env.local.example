# Distil - Local Build Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# CODE SIGNING
# ============================================================================

# Certificate identity for code signing (DO NOT include "Developer ID Application:" prefix)
# Example: CSC_NAME=John Doe (ABCD123456)
# Find yours with: security find-identity -v -p codesigning
CSC_NAME=Your Name (TEAM_ID)


# ============================================================================
# NOTARIZATION - Choose ONE option below
# ============================================================================

# Option A: App-Specific Password (Recommended for individuals)
# Create at: https://appleid.apple.com/account/manage
APPLE_ID=your-email@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=ABCD123456

# Option B: API Key (Recommended for teams/CI)
# Uncomment these and comment out Option A if using API Key
# Get from: https://appstoreconnect.apple.com/access/api
# APPLE_API_KEY=/path/to/AuthKey_ABC123.p8
# APPLE_API_KEY_ID=ABC123DEF4
# APPLE_API_ISSUER=11223344-5566-7788-99aa-bbccddeeff00


# ============================================================================
# GITHUB PUBLISHING
# ============================================================================

# GitHub Personal Access Token (with 'repo' scope)
# Create at: https://github.com/settings/tokens
# Only needed for manual publishes via `npm run publish`
GH_TOKEN=ghp_yourGitHubTokenHere


# ============================================================================
# NOTES
# ============================================================================

# - This file is gitignored and will not be committed
# - See BUILD_SETUP.md for detailed setup instructions
# - All values are loaded by scripts/notarize.cjs via dotenv
# - For GitHub Actions, configure secrets in repository settings
