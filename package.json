{
  "name": "Distil",
  "private": true,
  "version": "0.3.14",
  "description": "A writing environment for turning thought into prose",
  "author": "Martin Lissmyr <martin@lissmyr.com>",
  "type": "module",
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:pdf-styles && tsc && vite build && electron-builder",
    "build:pdf-styles": "sass electron/export/pdfStyles.scss electron/export/pdfStyles.css && mkdir -p dist-electron && cp electron/export/pdfStyles.css dist-electron/",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "npm run test:llm-contracts",
    "test:llm-contracts": "tsc -p tsconfig.test.json && node --test .tmp-tests/test/chat/contextClassifierContract.test.js",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "dist": "electron-builder",
    "publish": "electron-builder --mac --publish always",
    "serve-site": "node scripts/serve-site.mjs"
  },
  "build": {
    "appId": "com.martinlissmyr.distil",
    "productName": "Distil",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "fileAssociations": [
        {
          "ext": "distilproject",
          "name": "Distil Project",
          "role": "Editor"
        },
        {
          "ext": "distilauthor",
          "name": "Distil Author Workspace",
          "role": "None"
        }
      ],
      "protocols": [
        {
          "name": "Distil Project",
          "schemes": [
            "distilproject"
          ]
        }
      ],
      "extendInfo": {
        "UTExportedTypeDeclarations": [
          {
            "UTTypeConformsTo": [
              "com.apple.package",
              "public.composite-content",
              "public.data"
            ],
            "UTTypeDescription": "Distil Project",
            "UTTypeIdentifier": "com.martinlissmyr.distil.project",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "distilproject"
              ]
            }
          },
          {
            "UTTypeConformsTo": [
              "com.apple.package",
              "public.composite-content",
              "public.data"
            ],
            "UTTypeDescription": "Distil Author Workspace",
            "UTTypeIdentifier": "com.martinlissmyr.distil.author",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "distilauthor"
              ]
            }
          }
        ]
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "martinlissmyr",
        "repo": "distil"
      }
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/styles": "^6.0.22",
    "@tiptap/extension-bubble-menu": "^3.28.0",
    "@tiptap/extension-heading": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/static-renderer": "^3.28.0",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "keytar": "^7.9.0",
    "lucide-react": "^0.554.0",
    "openai": "^6.48.0",
    "prosemirror-docx": "^0.6.1",
    "prosemirror-model": "^1.25.11",
    "prosemirror-search": "^1.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remend": "1.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.39.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^17.4.2",
    "electron": "41.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.7.0",
    "sass": "^1.101.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "main": "dist-electron/main.js"
}
