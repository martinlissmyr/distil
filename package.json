{
  "name": "Distil",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first writing tool for novelists built on the Layered Contextual Relevance Framework",
  "author": "Martin Lissmyr <martin@lissmyr.com>",
  "type": "module",
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:pdf-styles && tsc && vite build && electron-builder",
    "build:pdf-styles": "sass electron/export/pdfStyles.scss electron/export/pdfStyles.css && mkdir -p dist-electron && cp electron/export/pdfStyles.css dist-electron/",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "dist": "electron-builder",
    "publish": "electron-builder --mac --publish always"
  },
  "build": {
    "appId": "com.martinlissmyr.distil",
    "productName": "Distil",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": {
        "teamId": "J76YXS3HMK"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "martinlissmyr",
        "repo": "distil"
      }
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^8.3.9",
    "@mantine/hooks": "^8.3.9",
    "@mantine/styles": "^6.0.22",
    "@tiptap/extension-bubble-menu": "^3.14.0",
    "@tiptap/extension-heading": "^3.11.0",
    "@tiptap/extension-placeholder": "^3.11.0",
    "@tiptap/markdown": "^3.11.0",
    "@tiptap/react": "^3.11.0",
    "@tiptap/starter-kit": "^3.11.0",
    "@tiptap/static-renderer": "^3.15.3",
    "docx": "^9.5.1",
    "electron-updater": "^6.6.2",
    "keytar": "^7.9.0",
    "lucide-react": "^0.554.0",
    "openai": "^6.9.1",
    "prosemirror-docx": "^0.6.1",
    "prosemirror-model": "^1.25.4",
    "prosemirror-search": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.39.2",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^4.2.1",
    "dotenv": "^17.2.3",
    "electron": "40.0.0-beta.2",
    "electron-builder": "^26.5.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^17.1.0",
    "sass": "^1.94.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
